+// SSI DEV024B1: scoped PDF child-sheet plot viewport with a device-space clip.
+bool PDF_PLOTTER::BeginSheetPreview( const VECTOR2I& aTopLeft, const VECTOR2I& aSize,
+                                     const VECTOR2I& aChildPageSize )
+{
+    if( m_ssiPreviewActive || !m_workFile || aChildPageSize.x <= 0 || aChildPageSize.y <= 0 )
+        return false;
+
+    const double factor = std::min( 0.94 * aSize.x / aChildPageSize.x,
+                                    0.94 * aSize.y / aChildPageSize.y );
+
+    if( factor <= 0.0 )
+        return false;
+
+    m_ssiPreviewOffset = m_plotOffset;
+    m_ssiPreviewScale = m_plotScale;
+    m_ssiPreviewIUsPerDecimil = m_IUsPerDecimil;
+    m_ssiPreviewMirror = m_plotMirror;
+
+    const VECTOR2D p1 = userToDeviceCoordinates( aTopLeft );
+    const VECTOR2D p2 = userToDeviceCoordinates( aTopLeft + aSize );
+    const double x = std::min( p1.x, p2.x );
+    const double y = std::min( p1.y, p2.y );
+    const double w = std::abs( p2.x - p1.x );
+    const double h = std::abs( p2.y - p1.y );
+    fmt::println( m_workFile, "q {} {} {} {} re W n", x, y, w, h );
+
+    const VECTOR2D origin = VECTOR2D( aTopLeft ) + VECTOR2D( aSize ) * 0.5
+                            - VECTOR2D( aChildPageSize ) * ( factor * 0.5 );
+    const VECTOR2D offset = ( VECTOR2D( m_ssiPreviewOffset ) - origin ) / factor;
+    SetViewport( VECTOR2I( static_cast<int>( std::lround( offset.x ) ),
+                              static_cast<int>( std::lround( offset.y ) ) ),
+                 m_ssiPreviewIUsPerDecimil, m_ssiPreviewScale * factor, m_ssiPreviewMirror );
+    m_ssiPreviewActive = true;
+    return true;
+}
+
+void PDF_PLOTTER::EndSheetPreview()
+{
+    if( !m_ssiPreviewActive )
+        return;
+
+    fmt::println( m_workFile, "Q" );
+    SetViewport( m_ssiPreviewOffset, m_ssiPreviewIUsPerDecimil,
+                 m_ssiPreviewScale, m_ssiPreviewMirror );
+    // PDF Q restores the graphics state; invalidate cached pen/color state.
+    m_currentPenWidth = -1;
+    m_ssiPreviewActive = false;
+}
 
